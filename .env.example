# ============================================================
# AI 新闻辅助工作台 — 环境变量配置
# ============================================================
# 复制本文件为 .env 并填入真实值：
#   cp .env.example .env
#
# 所有敏感信息（密钥、数据库连接）只通过环境变量注入，
# 不写入代码、不提交 git、不打印到日志。
# ============================================================

# ------------------------------------------------------------
# 1. 数据库（Supabase / PostgreSQL）
# ------------------------------------------------------------
# Supabase 项目 URL（在 Supabase Dashboard → Settings → API 中获取）
SUPABASE_URL=https://your-project-id.supabase.co
# Supabase anon key（公开，前端可用）
SUPABASE_ANON_KEY=your-anon-key
# Supabase service role key（服务端专用，拥有完整权限，切勿泄露）
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 注：为兼容沙箱环境，也支持 COZE_SUPABASE_URL / COZE_SUPABASE_ANON_KEY /
# COZE_SUPABASE_SERVICE_ROLE_KEY，标准名优先。

# ------------------------------------------------------------
# 2. 会话密钥
# ------------------------------------------------------------
# HMAC 签名会话 token 的密钥，建议 >= 32 字符随机串
# 更换后所有已登录用户需重新登录
SESSION_SECRET=change-me-to-a-random-string-at-least-32-chars

# ------------------------------------------------------------
# 3. 默认 AI 模型（可选）
# ------------------------------------------------------------
# 不配置时，AI 功能需通过后台「接入大模型」页面手动配置。
# 配置后作为全局默认模型，所有 AI 功能（选题建议/线索识别/评报生成）直接使用。
# 支持任意 OpenAI 兼容 API（豆包、DeepSeek、OpenAI、Ollama 等）。
DEFAULT_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DEFAULT_LLM_API_KEY=your-api-key
DEFAULT_LLM_MODEL=doubao-pro-32k

# ------------------------------------------------------------
# 4. 外部抓取服务接入令牌
# ------------------------------------------------------------
# 外部抓取服务调用 /api/ingest/* 时的 Bearer token。
# 也可在后台「系统配置」页面中修改（key: ingest.api_token）。
INGEST_API_TOKEN=newsdesk-ingest-2026

# ------------------------------------------------------------
# 5. 服务端口与域名（部署用）
# ------------------------------------------------------------
# Next.js 服务监听端口（默认 3000；沙箱环境由 DEPLOY_RUN_PORT 注入）
PORT=3000
# 对外访问域名（用于前端拼接绝对 URL，如 WebSocket、分享链接）
# 格式：https://your-domain.com（不含末尾斜杠）
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ------------------------------------------------------------
# 6. 运行环境
# ------------------------------------------------------------
# 标准 Node.js 环境变量，无需额外设置
NODE_ENV=production
