# ===== 服务 =====
# 留空 = 不鉴权（开箱即用）；设置后所有 /api/* 需带请求头 X-API-Key
API_KEY=
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
LOG_DIR=logs
DB_PATH=data/articles.db

# ===== 抓取 =====
FETCH_TIMEOUT=15
FETCH_RETRIES=3
FETCH_BACKOFF=2.0
REQUEST_DELAY=1.0
# 浏览器兜底（JS 渲染站点需要）。未安装 playwright 时会自动降级为纯 HTTP，不影响启动
# 如需启用：pip install -r requirements-playwright.txt && playwright install chromium
PLAYWRIGHT_FALLBACK=true
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0 Safari/537.36

# ===== 业务开关 =====
BUSINESS_DAILY_REVIEW=true
BUSINESS_NEWS_LEAD=false

# ===== 调度(可选, 默认关闭, 由扣子按需触发) =====
SCHEDULE_ENABLED=false
SCHEDULE_CRON=0 */2 * * *

# ===== 去重 =====
DEDUP_TTL_DAYS=30

# ===== 对接主项目 news-workbench（ingest 拉模式，默认关闭，需要时开启）=====
# 设为 true 后，worker 会常驻轮询主项目 /api/ingest/queue 并回推文章
INGEST_ENABLED=false
# 主项目 base URL（部署后填真实地址，如 https://your-domain.com）
MAIN_API_BASE=http://localhost:3000
# 与主项目 INGEST_API_TOKEN 一致（默认 newsdesk-ingest-2026，可在主项目后台轮换）
INGEST_API_TOKEN=newsdesk-ingest-2026
# worker 轮询间隔（秒）
POLL_INTERVAL=120
# 每个数据源抽样抓取篇数
WORKER_PER_SOURCE=5
